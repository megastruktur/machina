# Machina (MAI) compose environment — TEMPLATE.
# Copy to .env and fill in. The real .env is mode 600, gitignored, and is
# NEVER committed. Secret storage of record is the 1Password vault
# "Secrets"; this file only tells you which variable carries what.

# --- required by compose.yaml (render fails closed without them) ---
# 1Password item "Machina Postgres Password". Alphanumeric only (no @ : / #
# — DSN-hostile characters).
MAI_POSTGRES_PASSWORD=CHANGE_ME

# --- reverse proxy ---
# Host loopback port mai-proxy publishes (Tailscale serve terminates TLS and
# points at this port). Must be free on the host.
MAI_PROXY_HTTP_PORT=8390

# --- public origin + trusted proxy ---
# Exact origin the API allows (auth ADR §6): the Tailscale serve hostname.
MAI_PUBLIC_ORIGINS=https://machina.tail6fa4ba.ts.net
# CIDRs allowed to set X-Forwarded-* metadata: pinned to the `mai` compose
# network subnet declared in compose.yaml (networks.mai.ipam). If you change
# the subnet there, change it here.
MAI_TRUSTED_PROXIES=172.32.0.0/16

# --- application credentials source (C03 rule 6) ---
# ABSOLUTE host path to the EnvResolver credential file (mode 600, no
# symlink). It is bind-mounted read-only into mai-api/mai-worker at
# /run/secrets/mai-credentials.env and holds at minimum:
#   MAI_GATEWAY_KEY=<LiteLLM virtual key, 1P item "Machina LiteLLM Key">
MAI_ENV_FILE=/home/megastruktur/data/machina/mai-credentials.env

# --- first-admin bootstrap (auth ADR §3) ---
# 1Password item "Machina Admin Password". Read once at startup, dropped
# after hashing; remove from .env after the first successful bootstrap.
MAI_ADMIN_PASSWORD=CHANGE_ME

# --- LLM gateway endpoints (documentation for stack owners; the MAI model
#     connection doc is configured at runtime via the UI/API in M-2) ---
# Container-reachable LiteLLM endpoint (litellm container is on net-infra):
MAI_LLM_BASE_URL=http://litellm:4000/v1
MAI_EMBEDDINGS_BASE_URL=http://litellm:4000/v1

# --- hindsight (memory profile) ---
# Same gateway as the backend doc index (ADR §2.4/§4). Base URLs include
# /v1 (hindsight passes them to AsyncOpenAI verbatim).
HINDSIGHT_API_LLM_PROVIDER=openai
HINDSIGHT_API_LLM_MODEL=z-ai-coding/glm-5.3-flash
HINDSIGHT_API_LLM_BASE_URL=http://litellm:4000/v1
HINDSIGHT_API_LLM_API_KEY=CHANGE_ME
HINDSIGHT_API_EMBEDDINGS_PROVIDER=openai
HINDSIGHT_API_EMBEDDINGS_OPENAI_MODEL=text-embedding-3-small
HINDSIGHT_API_EMBEDDINGS_OPENAI_BASE_URL=http://litellm:4000/v1
HINDSIGHT_API_EMBEDDINGS_OPENAI_API_KEY=CHANGE_ME

# --- searxng pair (search profile) ---
# Any random string; generate with: python3 -c "import secrets;print(secrets.token_hex(32))"
SEARXNG_SECRET=CHANGE_ME
