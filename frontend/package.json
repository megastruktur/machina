{
	"name": "mai-web",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test:browser": "playwright test",
		"generate:session-channel": "(cd ../backend && uv run python -m mai.scripts.export_session_channel_schema --out ../frontend/src/lib/api/session-channel.schema.json) && pnpm exec json2ts --output src/lib/api/session-channel.generated.ts src/lib/api/session-channel.schema.json"
	},
	"devDependencies": {
		"@playwright/test": "1.64.0",
		"@sveltejs/adapter-node": "5.5.7",
		"@sveltejs/kit": "2.70.3",
		"@sveltejs/vite-plugin-svelte": "6.2.4",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26.6.6",
		"json-schema-to-typescript": "16.0.0",
		"svelte": "5.57.2",
		"svelte-check": "4.7.6",
		"tailwindcss": "^4.3.3",
		"typescript": "6.0.3",
		"vite": "7.3.7"
	},
	"packageManager": "pnpm@12.6.0",
	"dependencies": {
		"@fontsource/cinzel": "^5.3.0",
		"@fontsource/jetbrains-mono": "^5.3.0",
		"@fontsource/rajdhani": "^5.3.0",
		"@skeletonlabs/skeleton": "^5.0.1",
		"@skeletonlabs/skeleton-svelte": "^5.0.1",
		"@xterm/addon-fit": "^0.11.0",
		"@xterm/xterm": "^6.0.0",
		"lucide-svelte": "^1.0.1"
	}
}
